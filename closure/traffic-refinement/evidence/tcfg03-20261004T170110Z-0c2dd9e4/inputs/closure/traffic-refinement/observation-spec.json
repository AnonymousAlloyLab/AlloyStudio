  "observationRules": {
    "json": "Exact built-in JSON values; finite numbers; valid Unicode. Object key ordering is ignored. Array order and multiplicity, missing versus null fields and every semantic leaf are observable.",
    "feedback": "Preserve status, metric, every distance/breakdown/cost, exact ordered operations and tie-derived trace, canonical display, UTF-16 source/canonical locations, diagnostic code/text/coordinates, AST size and complete pool declaration. Correct-pool order and all references, including every oracle, belong to input identity; first minimum tie is retained. No zero-distance short circuit. Invalid later reference means failure.",
    "behavior": "Primary oracle, exact model/environment/body, facts, scope, bitwidth, sequence and trace bounds and sampling algorithm are input identity. Preserve all sample counts, half-up 0.001 rounded score and availability reason, ordered four categories and truth flags, zero-to-three witness order, trace state order, signature/atom/relation/tuple order, loop state, truncation and anonymization flags. Shape checking does not establish actual Alloy witness truth.",
    "explanation": "Preserve status/model, one indexed description per operation and displayed instance in their evidence order, and summary. Same explicit provider response is compared exactly; independently sampled provider wording has no equality claim. No oracle/source/target expressions may be added to prompts or results by reuse.",
    "location": "Ranges are ordered unique half-open UTF-16 spans of exactly the admitted learner body or displayed canonical form; unavailable has no spans. Node precision is one structural occurrence, not a search for all equal strings. Reasons and line/column/module coordinates remain semantic fields.",
    "failures": "Failures are observable and never count as a successful hit, even when equal. No error/unsupported/timeout/busy result may be coerced to success or empty distance. Exact diagnostics/messages are compared. Capacity/cancel/expiry are explicit permitted transport outcomes, not computational equality exceptions.",
    "admin": "The whole authenticated JSON response is retained recursively with no fields erased; authentication, cookies, status and authorization are an independent transport envelope. TRF-00 freezes observation only, not admin correctness. New fields cannot silently disappear from equality.",
    "other": "Catalogue and exercise schemas are closed; list order and source/environment bytes remain exact. Assets retain exact body bytes via SHA-256 under declared collision resistance plus MIME and byte length. Dashboard/control JSON retains every field recursively.",
    "httpEnvelope": "Method, path, HTTP status, content type, Location, authentication cookies and security headers are separately observed. Date, Content-Length (checked against body), Server, connection-close mechanics, cache validators, Cache-Control and explicit Retry-After are transport metadata. A 304 is compared only after successful validator-based resolution to the exact retained prior 200 entity. No blind omission of 304 or private cache changes.",
    "delivery": "exerciseId, revision and requestedMetric must equal the current subscriber context when provided; evidenceToken and behaviorToken have fixed shape but require separate exact evidence binding/capability checks. They are stripped only from computational comparison, never from delivery validation.",
    "nondeterminism": "No solver, atom-name, tuple-order, score, category or diagnostic difference is permitted by this contract. Host timing, process identifiers, scheduling interleavings, random channel/evidence capabilities and external provider wording are outside computational equality only at explicit distinct boundaries. A future solver-equivalence relaxation requires a new frozen specification and Alloy witness checker; no blanket ignoring differences.",
    "independence": "Checker imports no production server, projector, scheduler, worker or provider implementation. Baseline projection inventory is extracted mechanically from pinned Git objects, not copied from optimized equality. Schema declaration is independent; JSON equality checks only this admitted contract.",
    "schemaBounds": "Unspecified array/text semantic maxima here use the finite encoded request/response byte envelope, not arbitrary unbounded network allocation. Existing domain-specific limits are explicit. Schema validator is an offline finite-evidence tool, not an inbound JSON parser."
  },
  "tcb": [
    "Python built-in JSON, exact types, Unicode and integer arithmetic, standard library and Git object retrieval",
    "Declared frozen schema interpreter and baseline extraction implementation",
    "SHA-256 collision resistance, filesystem/process behavior, host hardware"
  ],
  "excluded": [
    "Universal original/optimized semantic refinement; future requests outside finite evidence",
    "Lean proof of Python/Java/Alloy execution, solver witness truth, natural-language correctness/non-disclosure",
    "Delivery authentication/capability state-machine correctness and native deployment behavior"
  ],
  "passConditions": [
    "Pinned baseline SHA-256 source inventory and exact projection inventory match",
    "Every accepted semantic response field is retained; malformed/unknown analysis fields reject",
    "Ordered lists and diagnostic failure classes are exact; all declared independent invariants pass",
    "Constructed mutation witnesses detect omitted costs, swapped operations/occurrences, partial pools, category drift, score drift, delivery confusion, and nested target disclosure"
  ]
